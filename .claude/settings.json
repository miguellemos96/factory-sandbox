{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Skill",
      "Agent",
      "TodoWrite",
      "Bash(git *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run rerun *)",
      "Bash(gh run watch *)",
      "Bash(gh api user *)",
      "Bash(gh api -X POST repos/*/statuses/*)",
      "Bash(npm ci)",
      "Bash(npm test *)",
      "Bash(npm test)",
      "Bash(npm run *)",
      "Bash(npm start *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(pwd)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api graphql*)",
      "Bash(gh secret *)",
      "Bash(gh repo *)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue edit *tests-change-approved*)",
      "Bash(gh pr edit *tests-change-approved*)",
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.mjs\""
          }
        ]
      }
    ]
  }
}
